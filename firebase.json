{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/jobs", "destination": "/jobs.html", "type": 301 },
      { "source": "/jobs/", "destination": "/jobs.html", "type": 301 }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
